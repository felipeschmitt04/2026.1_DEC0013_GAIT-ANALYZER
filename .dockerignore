# Environment and local tooling
.env
.env.*
!.env.example
.DS_Store
.vscode/
.idea/

# Runtime storage
backend/storage/uploads/*
backend/storage/results/*
backend/storage/jobs/*
backend/storage/temp/*
!backend/storage/uploads/.gitkeep
!backend/storage/results/.gitkeep
!backend/storage/jobs/.gitkeep
!backend/storage/temp/.gitkeep

